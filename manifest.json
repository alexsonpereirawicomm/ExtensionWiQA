{
  "manifest_version": 3,
  "name": "WiControl QA",
  "version": "1.3.0",
  "description": "Ferramenta de captura de tela e gravação para QA - Wicomm",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Abrir WiControl QA (Alt+Shift+Q)",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Abrir o painel de QA"
    },
    "quick-screenshot": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Captura rápida da página atual"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "tabCapture",
    "sidePanel",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": [
    "https://gfzsahqvxloggzlvrpxr.supabase.co/*"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
